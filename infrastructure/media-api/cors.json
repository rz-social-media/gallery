{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://rz-social-media.github.io",
          "https://rz-gallery.pages.dev"
        ],
        "methods": [
          "GET",
          "PUT",
          "HEAD"
        ],
        "headers": [
          "Content-Type"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
